<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Biometric HUD Frame -->
    <FrameLayout
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_gravity="center"
        android:layout_marginBottom="28dp">

        <View
            android:id="@+id/scannerGlowRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:drawable/radiobutton_off_background"
            android:backgroundTint="#38BDF8"
            android:alpha="0.45" />

        <View
            android:id="@+id/laserScanLine"
            android:layout_width="220dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="45dp"
            android:background="#22C55E" />
    </FrameLayout>

    <!-- Royal Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E60F172A"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- स्कूल का नया रॉयल लोगो + नीचे छोटे अक्षरों में स.म.वि. (VIP स्वागत ट्रिगर के साथ) -->
            <FrameLayout
                android:id="@+id/logoVipTrigger"
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_school_logo"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="3dp"
                    android:gravity="center"
                    android:text="स.म.वि."
                    android:textColor="#FDE047"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="सर्वोदय मध्य विद्यालय, सोहसराय"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28.10.2026"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAdminLock"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#1E3A8A"
                android:text="🔒 एडमिन"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScannerOnlyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FEF3C7"
            android:padding="5dp"
            android:gravity="center"
            android:text="🛡️ स्कैनर मोड"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Live School Ticker Row (लाइव स्कैन + लाइव उपस्थिति काउंटर) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="#D90F172A"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 लाइव स्कैन"
                android:textColor="#4ADE80"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="|"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLiveTickerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 उपस्थित: 0/0 (0%)"
                android:textColor="#FDE047"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Royal Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#E60F172A"
        android:padding="14dp">

        <!-- स्कैन रिजल्ट कार्ड (छात्र की रजिस्टर्ड बायोमेट्रिक फोटो के साथ) -->
        <LinearLayout
            android:id="@+id/resultCardBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- बाईं तरफ छात्र की रजिस्टर्ड फोटो -->
            <ImageView
                android:id="@+id/ivResultStudentPhoto"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginEnd="12dp"
                android:scaleType="centerCrop"
                android:background="#E2E8F0"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvResultLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvResultDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="28.10.2026"
                        android:textColor="#475569"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResultName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="राहुल कुमार"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="कक्षा: 7वीं | रोल: 07"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultSubNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="✔ उपस्थित"
                    android:textColor="#15803D"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTorchIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:backgroundTint="#334155"
                android:text="🔦"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnManualScanTrigger"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:backgroundTint="#16A34A"
                android:text="📷 स्कैन करें"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSwitchCamIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#334155"
                android:text="🔄"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnVoiceIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:backgroundTint="#16A34A"
                android:text="🔊"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShareTodayAtt"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#0369A1"
                android:text="📤 हाज़िरी भेजें"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLoadPack"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1E293B"
                android:text="📥 पैक लोड"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
