<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Biometric HUD Frame -->
    <FrameLayout
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_gravity="center"
        android:layout_marginBottom="28dp">

        <View
            android:id="@+id/scannerGlowRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:drawable/radiobutton_off_background"
            android:backgroundTint="#38BDF8"
            android:alpha="0.45" />

        <View
            android:id="@+id/laserScanLine"
            android:layout_width="220dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="45dp"
            android:background="#22C55E" />
    </FrameLayout>

    <!-- Royal Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E60F172A"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#EA580C"
                android:gravity="center"
                android:text="स"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="सर्वोदय मध्य विद्यालय, सोहसराय"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="27.10.2026"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAdminLock"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#1E3A8A"
                android:text="🔒 एडमिन"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScannerOnlyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FEF3C7"
            android:padding="5dp"
            android:gravity="center"
            android:text="🛡️ स्कैनर मोड"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="#CC0F172A"
            android:paddingHorizontal="18dp"
            android:paddingVertical="6dp"
            android:text="🟢 लाइव स्कैन"
            android:textColor="#4ADE80"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Royal Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#E60F172A"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/resultCardBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvResultLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="✅"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/tvResultDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="27.10.2026"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginVertical="6dp"
                android:background="#CBD5E1" />

            <TextView
                android:id="@+id/tvResultName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="राहुल कुमार"
                android:textColor="#000000"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="कक्षा: 7वीं | रोल: 07"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultSubNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="✔ उपस्थित"
                android:textColor="#15803D"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTorchIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:backgroundTint="#334155"
                android:text="🔦"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnManualScanTrigger"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:backgroundTint="#16A34A"
                android:text="📷 स्कैन करें"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSwitchCamIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#334155"
                android:text="🔄"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnVoiceIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:backgroundTint="#16A34A"
                android:text="🔊"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShareTodayAtt"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#0369A1"
                android:text="📤 हाज़िरी भेजें"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLoadPack"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1E293B"
                android:text="📥 पैक लोड"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
