<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Neon Aura -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#CC00F0FF"
                android:centerColor="#CCD946EF"
                android:endColor="#CC00F0FF" />
            <padding
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp" />
        </shape>
    </item>
    <!-- Bright White-Cyan Core Neon Ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2.2dp"
                android:color="#FFFFFF" />
            <solid android:color="#1A00F0FF" />
            <padding
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp" />
        </shape>
    </item>
</layer-list>
